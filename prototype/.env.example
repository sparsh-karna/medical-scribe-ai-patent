# Copy to prototype/.env and fill in. prototype/.env is gitignored.

# LLM extractor (used by `main.py run --llm` and the web app's "AI extractor" toggle).
# Set one key; if both are set, Gemini is used unless LLM_PROVIDER says otherwise.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
# LLM_PROVIDER=gemini

# Local models (downloaded on first use from Hugging Face).
# WHISPER_MODEL=base.en            # small.en / medium.en are more accurate but need more RAM
# NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# HF_HOME=E:/huggingface           # where models are cached (default: ~/.cache/huggingface)
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# PRIMOCK_AUDIO_DIR=E:/primock57_audio   # where eval/ scripts keep PriMock57 audio
